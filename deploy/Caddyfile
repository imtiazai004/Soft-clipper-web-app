# DOMAIN comes from the environment (see docker-compose.yml).
#   DOMAIN=:80                 -> plain HTTP on the server's IP, for testing
#   DOMAIN=clips.example.com   -> automatic HTTPS via Let's Encrypt
#
# Uploads can be large videos, so the default request-body cap is lifted.
{$DOMAIN} {
	# Licence traffic goes to its own service. These paths are matched first
	# because the video app owns everything else under /api.
	@licence path /api/licence/* /api/admin/licences* /webhooks/stripe /admin
	handle @licence {
		reverse_proxy licence:8600
	}

	handle {
		reverse_proxy app:8501
	}

	request_body {
		max_size 5GB
	}
	encode gzip
}
