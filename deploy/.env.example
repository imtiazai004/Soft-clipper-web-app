# Copy to .env on the server and fill in. Never commit the real .env.
#   cp .env.example .env && nano .env

# ── how people reach the app ──────────────────────────────────────────────────
# Start with :80 to test on the raw IP. Once a domain's DNS points here, change
# this to the domain and Caddy switches to HTTPS on the next `up`.
DOMAIN=:80

# ── accounts ──────────────────────────────────────────────────────────────────
# "name:password" pairs, comma separated. This is what turns on multi-user mode
# with a login and a separate dashboard per person. Leave blank for single-user.
APP_USERS=imtiaz:changeme1,ali:changeme2

# Signs the login cookie. Generate ONCE and keep it, or a restart logs everyone
# out. Make one with:  openssl rand -hex 32
SESSION_SECRET=

# ── downloads ─────────────────────────────────────────────────────────────────
# The residential proxy that gets past YouTube's bot check. Put the real one in
# .env only — never here, this file is committed.
# Prefer socks5h:// : on 2026-07-26 the provider's HTTP tunnel (port 12323) began
# answering 502 for YouTube while everything else still worked, and SOCKS5 on
# 12324 with the same credentials was unaffected.
DOWNLOAD_PROXY=socks5h://USER:PASS@PROXY_HOST:12324

# ── AI ────────────────────────────────────────────────────────────────────────
# Optional shared Gemini key used when a user hasn't set their own in Settings.
# Leave blank to require each user to bring their own.
GEMINI_API_KEY=

# ── licence server (sells the desktop app) ────────────────────────────────────
# Generate once:  python -m licence.crypto keygen
# The matching public key is compiled into the desktop app. Lose this and every
# existing activation stops verifying.
LICENCE_PRIVATE_KEY=
# openssl rand -hex 24 — guards the /api/admin/licences endpoints.
LICENCE_ADMIN_TOKEN=
# From the Stripe dashboard, for the checkout webhook.
STRIPE_WEBHOOK_SECRET=
# Where the licence key email is sent from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@aisofttechsolution.com
SUPPORT_WHATSAPP=+44 7462 086661
# The link the customer gets with their key.
DOWNLOAD_URL=

# Pakistani manual checkout. The USD price configured in the admin is converted
# to whole PKR using the latest State Bank offer rate. Screenshots are kept in
# the licence service's private /data/payment-proofs directory; a licence is
# issued only after the transfer is approved in /admin.
BANK_PAYMENTS_ENABLED=1
BANK_PAYMENT_BANK=Bank Al-Habib
BANK_PAYMENT_TITLE=Imtiaz Ahmad
BANK_PAYMENT_ACCOUNT=20300981005116011
BANK_PAYMENT_QR_URL=https://softclipper.pro/payments/bank-al-habib-qr.jpeg
JAZZCASH_TITLE=Imtiaz Ahmad
JAZZCASH_NUMBER=03005863032

# What the dashboard's Publish button calls.
#
# The marketing site is static: changing a price or turning on a download saves
# the value here, but the pages keep showing what they were built with until the
# site is built again. Publish exists to trigger that build, and without this
# variable the button is dead and says so.
#
# Get it from whoever hosts the site — on Cloudflare Pages it is
# Settings → Builds & deployments → Deploy hooks → Create deploy hook, which
# gives you a URL to paste here. Treat it as a secret: anyone holding it can
# start a build. Restart the licence container after setting it.
PUBLISH_HOOK_URL=

# ── tuning ────────────────────────────────────────────────────────────────────
# How many clips may render at once. 4 GB of RAM handles 2 comfortably.
RENDER_SLOTS=2
# Parallel download fragments — higher fills a slow link better.
YTDLP_FRAGMENTS=4
# Delete downloads and clips this many hours after they were last written.
# A source video is 1-2 GB and nothing else ever removes it, so without this a
# 40 GB disk fills up and downloads start failing for unrelated-looking reasons.
# Anything a signed-in user currently has loaded is never touched. 0 disables it.
CLEANUP_HOURS=24
