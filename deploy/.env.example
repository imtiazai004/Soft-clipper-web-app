# Copy to .env on the server and fill in. Never commit the real .env.
#   cp .env.example .env && nano .env

# ── how people reach the app ──────────────────────────────────────────────────
# Start with :80 to test on the raw IP. Once a domain's DNS points here, change
# this to the domain and Caddy switches to HTTPS on the next `up`.
DOMAIN=:80

# ── accounts ──────────────────────────────────────────────────────────────────
# "name:password" pairs, comma separated. This is what turns on multi-user mode
# with a login and a separate dashboard per person. Leave blank for single-user.
APP_USERS=imtiaz:changeme1,ali:changeme2

# Signs the login cookie. Generate ONCE and keep it, or a restart logs everyone
# out. Make one with:  openssl rand -hex 32
SESSION_SECRET=

# ── downloads ─────────────────────────────────────────────────────────────────
# The residential proxy that gets past YouTube's bot check. Put the real one in
# .env only — never here, this file is committed.
# Prefer socks5h:// : on 2026-07-26 the provider's HTTP tunnel (port 12323) began
# answering 502 for YouTube while everything else still worked, and SOCKS5 on
# 12324 with the same credentials was unaffected.
DOWNLOAD_PROXY=socks5h://USER:PASS@PROXY_HOST:12324

# ── AI ────────────────────────────────────────────────────────────────────────
# Optional shared Gemini key used when a user hasn't set their own in Settings.
# Leave blank to require each user to bring their own.
GEMINI_API_KEY=

# ── licence server (sells the desktop app) ────────────────────────────────────
# Generate once:  python -m licence.crypto keygen
# The matching public key is compiled into the desktop app. Lose this and every
# existing activation stops verifying.
LICENCE_PRIVATE_KEY=
# openssl rand -hex 24 — guards the /api/admin/licences endpoints.
LICENCE_ADMIN_TOKEN=
# From the Stripe dashboard, for the checkout webhook.
STRIPE_WEBHOOK_SECRET=

# ── paying affiliates automatically (optional) ───────────────────────────────
# Leave STRIPE_SECRET_KEY blank and nothing half-works: the dashboard says Stripe
# payouts are off, the affiliate page only offers being paid by hand, and every
# commission is sent by you through Wise or PayPal and ticked off afterwards.
#
# Setting it turns on Stripe Connect: an affiliate onboards with Stripe, Stripe
# collects their identity and bank details, and one button on the admin page
# transfers everything they are owed.
#
# This key is a bigger secret than the webhook one above. The webhook secret only
# lets someone lie to us about a payment; **this one can move money out of the
# Stripe balance**. Restrict it in the Stripe dashboard to what it actually needs
# (Connect accounts: write, Transfers: write) and nothing else.
#
# Two things to do in Stripe before it works:
#   1. Enable Connect (Express accounts) on the account.
#   2. Add `account.updated` to the same webhook endpoint that already receives
#      checkout events (/webhooks/stripe). That event is what flips an affiliate
#      to "ready to be paid" on its own. Without it they are stuck reading "Stripe
#      has not finished checking you" — the Check again button on their dashboard
#      asks Stripe directly and is the fallback for exactly that.
#
# Money only leaves if the platform balance covers it. Stripe does not lend: a
# transfer with nothing in the balance is refused with its own message, which the
# admin page shows as-is.
STRIPE_SECRET_KEY=
# Where Stripe sends an affiliate when onboarding ends, and where it sends them
# if the link had already expired. Both default to the affiliate's own dashboard
# (AFFILIATE_PORTAL_URL), which is where the "are we verified yet" answer is.
# Only set these if you have built somewhere better to land.
AFFILIATE_RETURN_URL=
AFFILIATE_REFRESH_URL=
# Where new sign-ups and "asked to be paid" notices go. Defaults to MAIL_FROM.
AFFILIATE_NOTIFY=

# ── paying affiliates through PayPal (optional) ──────────────────────────────
# The second automatic rail. Needs a PayPal **Business** account with Payouts
# enabled — ask PayPal for it if the API answers AUTHORIZATION_ERROR; it is not
# on by default on every account. Keys come from developer.paypal.com → Apps.
#
# Reaches most of the world and needs nothing from the affiliate but the email
# address on their PayPal account. Not everywhere, though: Pakistan has no PayPal
# at all, so affiliates there still need Wise or being paid by hand.
#
# Two things that cost money if they are missed:
#   · Fees come off *their* end unless the account is set up otherwise, so an
#     affiliate can be told $11.70 and receive slightly less. Say so up front.
#   · A payout to an address with no PayPal account does not fail — it waits
#     unclaimed for 30 days and then comes back. The row here is already marked
#     paid, because the money did leave; check unclaimed payouts in PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# `sandbox` to test against PayPal's fake money. Defaults to live — a deployment
# quietly running in sandbox would report every payout as sent and move nothing.
PAYPAL_ENV=live

# ── paying affiliates through Wise (optional) ────────────────────────────────
# The rail that reaches furthest: money goes into an ordinary **bank account** in
# around 160 countries, including Pakistan, Bangladesh and Nigeria. The affiliate
# does **not** need a Wise account — we send, their bank receives.
#
# Needs a Wise **Business** account, verified, with a balance in the currency
# below. Token: Wise dashboard → Settings → API tokens (full access).
WISE_API_TOKEN=
# `sandbox` for wise.com's test environment. Live by default, same reasoning as
# PayPal above.
WISE_ENV=live
# Only if the token can see more than one profile. Blank finds the business one.
WISE_PROFILE_ID=
# What our Wise balance is held in. Commission is recorded in the currency the
# customer paid — dollars — and the transfer is priced from that side so a
# conversion can never spend more than the commission was. Change this and
# dollar commissions can no longer be sent through Wise.
WISE_SOURCE_CURRENCY=USD
# What the affiliate sees on their bank statement. Kept short: some banking
# networks truncate it.
WISE_REFERENCE=Soft Clipper
#
# Set to 1 to pay **Wise accounts only**: the affiliate gives the email address
# on their own Wise account, the money lands in their Wise balance, and no bank
# details ever pass through this service. Instant, cheaper, and nothing to type
# wrong.
#
# **Read this before switching it on.** Wise can *send* to around 160 countries
# but only *opens accounts* in far fewer — Pakistan, Bangladesh and Nigeria are
# on the first list and not the second. With this on, an affiliate in Pakistan
# cannot use the Wise rail at all and falls back to being paid by hand, which is
# the exact person the Wise rail was added for. Left off, the same affiliate is
# paid automatically into their own PKR bank account.
#
# It is a real choice either way — the trade is reach against simplicity — and it
# can be flipped later without touching anyone already set up.
WISE_WISE_ONLY=
#
# **The one that catches everybody.** Wise treats "move money out of the balance"
# as a strong-authentication action: the funding call comes back 403 with a
# one-time challenge that has to be signed with a private key registered in the
# Wise dashboard. Without this, transfers are *created but not funded* — they sit
# in Wise waiting for someone to approve them there, and the admin page says so
# rather than pretending the money went.
#
# Make one, register the public half in Wise (Settings → API tokens → Manage
# public keys), and put the private half here base64'd onto one line:
#   openssl genrsa -out wise.pem 2048
#   openssl rsa -in wise.pem -pubout -out wise.pub      # upload this one
#   base64 -w0 wise.pem                                  # paste the output below
WISE_PRIVATE_KEY=
# Where the licence key email is sent from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@aisofttechsolution.com
SUPPORT_WHATSAPP=+44 7462 086661
# The link the customer gets with their key.
DOWNLOAD_URL=

# Manual bank transfer/wallet checkout. The USD price configured in the admin is converted
# to whole PKR using the latest State Bank offer rate. Screenshots are kept in
# the licence service's private /data/payment-proofs directory; a licence is
# issued only after the transfer is approved in /admin.
BANK_PAYMENTS_ENABLED=1
BANK_PAYMENT_BANK=Bank Al-Habib
BANK_PAYMENT_TITLE=Imtiaz Ahmad
BANK_PAYMENT_IBAN=PK76BAHL2030098100511601
BANK_PAYMENT_QR_URL=https://softclipper.pro/payments/bank-al-habib-qr.jpeg
JAZZCASH_TITLE=Imtiaz Ahmad
JAZZCASH_NUMBER=03005863032

# What the dashboard's Publish button calls.
#
# The marketing site is static: changing a price or turning on a download saves
# the value here, but the pages keep showing what they were built with until the
# site is built again. Publish exists to trigger that build, and without this
# variable the button is dead and says so.
#
# Get it from whoever hosts the site — on Cloudflare Pages it is
# Settings → Builds & deployments → Deploy hooks → Create deploy hook, which
# gives you a URL to paste here. Treat it as a secret: anyone holding it can
# start a build. Restart the licence container after setting it.
PUBLISH_HOOK_URL=

# ── tuning ────────────────────────────────────────────────────────────────────
# How many clips may render at once. 4 GB of RAM handles 2 comfortably.
RENDER_SLOTS=2
# Parallel download fragments — higher fills a slow link better.
YTDLP_FRAGMENTS=4
# Delete downloads and clips this many hours after they were last written.
# A source video is 1-2 GB and nothing else ever removes it, so without this a
# 40 GB disk fills up and downloads start failing for unrelated-looking reasons.
# Anything a signed-in user currently has loaded is never touched. 0 disables it.
CLEANUP_HOURS=24
